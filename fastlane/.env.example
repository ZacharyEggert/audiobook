# Copy to fastlane/.env (git-ignored) for local runs. fastlane loads it automatically.
ASC_KEY_ID=
ASC_ISSUER_ID=
# Either a path to the .p8 file...
ASC_KEY_PATH=~/keys/AuthKey_XXXXXXXXXX.p8
# ...or its base64 content, as in CI: base64 -i AuthKey.p8
# ASC_KEY_P8_BASE64=
MATCH_GIT_URL=git@github.com:ZacharyEggert/ear-reader-certificates.git
MATCH_PASSWORD=
